@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@implements IAsyncDisposable

<RandomizeResetButtonGroup OnRandomizeClick="InstrumentConfigurationService.Randomize"
                           OnResetClick="InstrumentConfigurationService.ConfigureDefaults"/>
@if (!InstrumentConfigurationState.Value.IsValid)
{
    <MudAlert Severity="Severity.Warning"
              Class="mx-2 mt-2 mud-elevation-4"
              Variant="Variant.Outlined"
              Elevation="ThemeProvider.Elevation"
              ContentAlignment="HorizontalAlignment.Center"
              Dense="true">
        Invalid instrumentation. Please enable at least one instrument.
    </MudAlert>
}
<MudGrid Spacing="0" Justify="Justify.Center">
    @foreach (var instrument in InstrumentConfigurationService.ConfigurableInstruments)
    {
        <MudItem xs="12">
            <InstrumentConfigurationCard Instrument="instrument"/>
        </MudItem>
    }
</MudGrid>

<ScrollToTop/>

@code {
    private IDisposable? _instrumentConfigurationStateSubscription;

    private bool _wasVoiceSpacingSatisfiable;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // warn on the transition into unsatisfiability only, so an already-unsatisfiable configuration
        // does not toast on every visit to this panel.
        _wasVoiceSpacingSatisfiable = IsVoiceSpacingSatisfiable();

        _instrumentConfigurationStateSubscription = InstrumentConfigurationState
            .ObserveChanges()
            .Subscribe(_ =>
            {
                var isVoiceSpacingSatisfiable = IsVoiceSpacingSatisfiable();

                if (_wasVoiceSpacingSatisfiable && !isVoiceSpacingSatisfiable)
                {
                    Snackbar.Add(
                        $"The selected instrument ranges cannot satisfy the {CompositionRule.EnforceVoiceSpacing.ToSpaceSeparatedString()} rule. It will be skipped during composition.",
                        Severity.Warning
                    );
                }

                _wasVoiceSpacingSatisfiable = isVoiceSpacingSatisfiable;
            });
    }

    private bool IsVoiceSpacingSatisfiable() => VoiceSpacingSatisfiabilityAnalyzer.IsSatisfiable(
        InstrumentConfigurationState.Value.EnabledConfigurations,
        CompositionConfigurationState.Value.Scale
    );

    // FluxorComponent implements IAsyncDisposable, and Blazor only invokes the asynchronous overload when a
    // component offers both - a synchronous Dispose() here would never run (see CompositionProgress for the
    // same pattern).
    public new async ValueTask DisposeAsync()
    {
        _instrumentConfigurationStateSubscription?.Dispose();

        await base.DisposeAsync();
    }
}
