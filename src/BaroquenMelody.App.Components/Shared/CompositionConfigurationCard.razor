@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@implements IAsyncDisposable

<MudCard Class="rounded my-2 mx-2 mud-elevation-4" Elevation="ThemeProvider.Elevation" Outlined="true">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Composition Configuration</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" sm="6" md="2">
                <SelectWithPopover T="NoteName"
                                   Items="CompositionConfigurationService.ConfigurableRootNotes"
                                   Label="Tonic Note"
                                   ValueProvider="() => RootNote"
                                   ValueChanged="HandleTonicNoteChange"
                                   ConvertToDisplay="noteName => noteName.ToSpaceSeparatedString()">
                    <PopoverContent>
                        <MudText>The <MudLink Color="Color.Tertiary" Href="https://en.wikipedia.org/wiki/Tonic_(music)">tonic</MudLink> of the scale used in the composition. This is the "home" note of the scale which is often returned to.</MudText>
                    </PopoverContent>
                </SelectWithPopover>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <SelectWithPopover T="Mode"
                                   Items="CompositionConfigurationService.ConfigurableScaleModes"
                                   Label="Mode"
                                   ValueProvider="() => Mode"
                                   ValueChanged="HandleModeChange"
                                   ConvertToDisplay="mode => mode.ToSpaceSeparatedString()">
                    <PopoverContent>
                        <MudText>The <MudLink Color="Color.Tertiary" Href="https://en.wikipedia.org/wiki/Mode_(music)">mode</MudLink> of the scale used in the composition. A musical mode will affect the overall feel of the music.</MudText>
                    </PopoverContent>
                </SelectWithPopover>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <SelectWithPopover T="Meter"
                                   Items="CompositionConfigurationService.ConfigurableMeters"
                                   Label="Meter"
                                   ValueProvider="() => Meter"
                                   ValueChanged="HandleMeterChange"
                                   ConvertToDisplay="meter => meter.AsString()">
                    <PopoverContent>
                        <MudText>The <MudLink Color="Color.Tertiary" Href="https://en.wikipedia.org/wiki/Metre_(music)">meter</MudLink> of the composition. The meter will affect the rhythmic feel of the music.</MudText>
                    </PopoverContent>
                </SelectWithPopover>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <SelectWithPopover T="CompositionForm"
                                   Items="CompositionConfigurationService.ConfigurableCompositionForms"
                                   Label="Form"
                                   ValueProvider="() => Form"
                                   ValueChanged="HandleFormChange"
                                   ConvertToDisplay="form => form.ToSpaceSeparatedString()">
                    <PopoverContent>
                        <MudText>The <MudLink Color="Color.Tertiary" Href="https://en.wikipedia.org/wiki/Musical_form">form</MudLink> of the composition: a fugue, or variations over a repeating <MudLink Color="Color.Tertiary" Href="https://en.wikipedia.org/wiki/Ground_bass">ground bass</MudLink>.</MudText>
                    </PopoverContent>
                </SelectWithPopover>
            </MudItem>
            @if (Form == CompositionForm.GroundBass)
            {
                var feasibleGroundBasses = FeasibleGroundBasses;

                <MudItem xs="12" sm="6" md="2">
                    <SelectWithPopover T="GroundBass?"
                                       Items="CompositionConfigurationService.ConfigurableGroundBassPatterns"
                                       Label="Ground Bass Pattern"
                                       ValueProvider="() => GroundBassPattern"
                                       ValueChanged="HandleGroundBassPatternChange"
                                       ConvertToDisplay="ConvertGroundBassPatternToDisplay">
                        <PopoverContent>
                            <MudText>The repeating bass pattern (<MudLink Color="Color.Tertiary" Href="https://en.wikipedia.org/wiki/Ground_bass">ground</MudLink>) stated beneath the composition. Random lets the composer draw among the patterns that fit the lowest voice's range; a pattern marked as not fitting would fall back to the fugue form.</MudText>
                        </PopoverContent>
                    </SelectWithPopover>
                    @if (GroundBassPattern is { } selectedGroundBass)
                    {
                        if (!feasibleGroundBasses.Contains(selectedGroundBass))
                        {
                            <MudTooltip Text="The selected pattern cannot anchor in the lowest voice's range for the selected key, so the composition will fall back to the fugue form. Extend the lowest voice's range downward, choose another key, or pick a pattern that fits.">
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Outlined.Warning">Selected ground doesn't fit</MudChip>
                            </MudTooltip>
                        }
                    }
                    else if (feasibleGroundBasses.Count == 0)
                    {
                        <MudTooltip Text="No ground bass pattern can anchor in the lowest voice's range for the selected key, so the composition will fall back to the fugue form. Extend the lowest voice's range downward or choose another key to host a ground.">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Outlined.Warning">No grounds fit</MudChip>
                        </MudTooltip>
                    }
                    else if (feasibleGroundBasses.Count < GroundBassFeasibilityAnalyzer.GroundBassBank.Count)
                    {
                        <MudTooltip Text="@BuildReducedGroundBankTooltip(feasibleGroundBasses)">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Outlined.Info">@feasibleGroundBasses.Count of @GroundBassFeasibilityAnalyzer.GroundBassBank.Count grounds @(feasibleGroundBasses.Count == 1 ? "fits" : "fit")</MudChip>
                        </MudTooltip>
                    }
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudTooltip Text="Whether the composition may journey to the relative key for its middle statements and return home. The journey happens in the Ionian and Aeolian modes when the composition is long enough, the relative rendering fits the lowest voice's range, and the ground meets itself singably at the key seams; otherwise the piece simply stays in its home key.">
                        <MudSwitch T="bool"
                                   Label="Modulate"
                                   Value="GroundBassModulate"
                                   Color="Color.Tertiary"
                                   ValueChanged="HandleGroundBassModulateChange"/>
                    </MudTooltip>
                </MudItem>
            }
            <MudItem xs="12" sm="6" md="2">
                <NumericInputWithPopover T="int"
                                         Label="Minimum Measures"
                                         ValueChanged="HandleCompositionLengthChange"
                                         ValueProvider="() => MinimumMeasures"
                                         Min="1"
                                         Max="int.MaxValue">
                    <PopoverContent>
                        <MudText>The minimum number of <MudLink Color="Color.Tertiary" Href="https://en.wikipedia.org/wiki/Bar_(music)">measures</MudLink> in the composition.</MudText>
                    </PopoverContent>
                </NumericInputWithPopover>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <NumericInputWithPopover T="int"
                                         Label="Tempo"
                                         ValueChanged="HandleTempoChange"
                                         ValueProvider="() => Tempo"
                                         Min="1"
                                         Max="int.MaxValue">
                    <PopoverContent>
                        <MudText>The <MudLink Color="Color.Tertiary" Href="https://en.wikipedia.org/wiki/Tempo">tempo</MudLink>, or beats per minute (BPM) of the composition.</MudText>
                    </PopoverContent>
                </NumericInputWithPopover>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    private IDisposable? _compositionConfigurationStateSubscription;

    private IDisposable? _instrumentConfigurationStateSubscription;

    private bool _wasGroundBassFallingBackToFugue;

    private NoteName RootNote => CompositionConfigurationState.Value.TonicNote;

    private Mode Mode => CompositionConfigurationState.Value.Mode;

    private Meter Meter => CompositionConfigurationState.Value.Meter;

    private CompositionForm Form => CompositionConfigurationState.Value.Form;

    private GroundBass? GroundBassPattern => CompositionConfigurationState.Value.GroundBassPattern;

    private bool GroundBassModulate => CompositionConfigurationState.Value.GroundBassModulate;

    private int MinimumMeasures => CompositionConfigurationState.Value.MinimumMeasures;

    private int Tempo => CompositionConfigurationState.Value.Tempo;

    private IReadOnlyList<GroundBass> FeasibleGroundBasses => GroundBassFeasibilityAnalyzer.GetFeasibleGroundBasses(
        InstrumentConfigurationState.Value.EnabledConfigurations,
        CompositionConfigurationState.Value.Scale
    );

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // warn on the transition into the fallback only, so an already-fallen-back configuration does not
        // toast on every visit to this panel (the chip under the form select carries the persistent state).
        // Key and form edits arrive on the composition stream; the instrument stream is also observed because
        // a key change realigns the instrument ranges through an effect after this card's own stream fires.
        _wasGroundBassFallingBackToFugue = IsGroundBassFallingBackToFugue();

        _compositionConfigurationStateSubscription = CompositionConfigurationState
            .ObserveChanges()
            .Subscribe(_ => WarnWhenGroundBassStartsFallingBackToFugue());

        _instrumentConfigurationStateSubscription = InstrumentConfigurationState
            .ObserveChanges()
            .Subscribe(_ => WarnWhenGroundBassStartsFallingBackToFugue());
    }

    private void WarnWhenGroundBassStartsFallingBackToFugue()
    {
        var isGroundBassFallingBackToFugue = IsGroundBassFallingBackToFugue();

        if (!_wasGroundBassFallingBackToFugue && isGroundBassFallingBackToFugue)
        {
            Snackbar.Add(GroundBassWarnings.ForPattern(GroundBassPattern), Severity.Warning);
        }

        _wasGroundBassFallingBackToFugue = isGroundBassFallingBackToFugue;
    }

    private bool IsGroundBassFallingBackToFugue() => Form == CompositionForm.GroundBass && !GroundBassFeasibilityAnalyzer.HasFeasibleGround(
        InstrumentConfigurationState.Value.EnabledConfigurations,
        CompositionConfigurationState.Value.Scale,
        GroundBassPattern
    );

    private string ConvertGroundBassPatternToDisplay(GroundBass? groundBassPattern) => groundBassPattern is { } groundBass
        ? FeasibleGroundBasses.Contains(groundBass)
            ? groundBass.ToSpaceSeparatedString()
            : $"{groundBass.ToSpaceSeparatedString()} (doesn't fit)"
        : "Random";

    private static string BuildReducedGroundBankTooltip(IReadOnlyList<GroundBass> feasibleGroundBasses) =>
        $"Grounds that fit the lowest voice's range: {string.Join(", ", feasibleGroundBasses.Select(static groundBass => groundBass.ToSpaceSeparatedString()))}. Extend the lowest voice's range downward to host the whole bank.";

    // FluxorComponent implements IAsyncDisposable, and Blazor only invokes the asynchronous overload when a
    // component offers both - a synchronous Dispose() here would never run (see CompositionProgress for the
    // same pattern).
    public new async ValueTask DisposeAsync()
    {
        _compositionConfigurationStateSubscription?.Dispose();
        _instrumentConfigurationStateSubscription?.Dispose();

        await base.DisposeAsync();
    }

    private void HandleTonicNoteChange(NoteName note) => Dispatcher.Dispatch(new UpdateCompositionConfiguration(note, Mode, Meter, MinimumMeasures, Tempo, Form, GroundBassPattern, GroundBassModulate));

    private void HandleModeChange(Mode mode) => Dispatcher.Dispatch(new UpdateCompositionConfiguration(RootNote, mode, Meter, MinimumMeasures, Tempo, Form, GroundBassPattern, GroundBassModulate));

    private void HandleMeterChange(Meter meter) => Dispatcher.Dispatch(new UpdateCompositionConfiguration(RootNote, Mode, meter, MinimumMeasures, Tempo, Form, GroundBassPattern, GroundBassModulate));

    private void HandleFormChange(CompositionForm form) => Dispatcher.Dispatch(new UpdateCompositionConfiguration(RootNote, Mode, Meter, MinimumMeasures, Tempo, form, GroundBassPattern, GroundBassModulate));

    private void HandleGroundBassPatternChange(GroundBass? groundBassPattern) => Dispatcher.Dispatch(new UpdateCompositionConfiguration(RootNote, Mode, Meter, MinimumMeasures, Tempo, Form, groundBassPattern, GroundBassModulate));

    private void HandleGroundBassModulateChange(bool groundBassModulate) => Dispatcher.Dispatch(new UpdateCompositionConfiguration(RootNote, Mode, Meter, MinimumMeasures, Tempo, Form, GroundBassPattern, groundBassModulate));

    private void HandleCompositionLengthChange(int length) => Dispatcher.Dispatch(new UpdateCompositionConfiguration(RootNote, Mode, Meter, length, Tempo, Form, GroundBassPattern, GroundBassModulate));

    private void HandleTempoChange(int tempo) => Dispatcher.Dispatch(new UpdateCompositionConfiguration(RootNote, Mode, Meter, MinimumMeasures, tempo, Form, GroundBassPattern, GroundBassModulate));
}
