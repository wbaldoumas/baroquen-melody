{
  "stryker-config": {
    "project-info": {
      "name": "github.com/wbaldoumas/baroquen-melody",
      "module": "app-components"
    },
    "reporters": [
      "progress",
      "json",
      "markdown",
      "html"
    ],
    "mutate": [
      "**/*.cs",
      "!**/obj/**",
      "!**/bin/**"
    ],
    "since": {
      "enabled": false,
      "ignore-changes-in": [
        "**/*.csproj",
        "**/stryker-config.json"
      ]
    },
    "ignore-methods": [
      "*Exception.ctor"
    ],
    "break-on-initial-test-failure": true,
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    }
  }
}
